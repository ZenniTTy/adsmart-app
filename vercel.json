{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "cd site && bun install --frozen-lockfile",
	"buildCommand": "cd site && bun run build",
	"outputDirectory": "site/dist",
	"ignoreCommand": "git diff --quiet HEAD^ HEAD -- site/ docs/ CHANGELOG.md icon.png vercel.json"
}
