{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(bun install)",
			"Bash(bun run lint)",
			"Bash(bun run format)",
			"Bash(bun run typecheck)",
			"Bash(bun run test)",
			"Bash(bun run check)",
			"Bash(bun test:*)",
			"Bash(git status)",
			"Bash(git diff:*)",
			"Bash(git log:*)"
		],
		"ask": ["Bash(git push:*)", "Bash(bun add:*)", "Bash(bun remove:*)"],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(**/*credentials*.json)",
			"Read(**/*service-account*.json)",
			"Read(**/*-key.json)",
			"Read(~/.adsmart/**)"
		]
	}
}
