---
import { Code } from "@astrojs/starlight/components";
import { nomePacote, REPOSITORIO, urlDownload } from "../../scripts/conteudo.ts";
import { localeFromStarlight } from "../../scripts/locale.ts";
import { traducoes } from "../../scripts/traducoes.ts";
import lancamento from "../gerado/lancamento.json";

const locale = localeFromStarlight(Astro.locals.starlightRoute.locale);
const t = traducoes(locale).download;
const versao: string | null = lancamento.versao;
const arquivo = versao ? nomePacote(versao) : null;
const downloadUrl = versao ? urlDownload(versao) : null;
const comando =
	arquivo && downloadUrl
		? `curl -fL -o ~/Downloads/${arquivo} ${downloadUrl} && open ~/Downloads/${arquivo}`
		: "";
const conferencia =
	arquivo && downloadUrl
		? `cd ~/Downloads && curl -fLO ${downloadUrl}.sha256 && shasum -a 256 -c ${arquivo}.sha256`
		: "";
---

<section class="download" id="baixar">
	{
		versao ? (
			<>
				<div class="botoes">
					<a class="botao" href={downloadUrl} download={arquivo} data-download>
						{t.botao} · v{versao}
					</a>
					<span class="botao desativado" aria-disabled="true" data-windows>
						{t.windows}
					</span>
				</div>
				<p>{t.terminalIntro}</p>
				<Code code={comando} lang="sh" />
				<details>
					<summary>{t.conferenciaTitulo}</summary>
					<Code code={conferencia} lang="sh" />
				</details>
			</>
		) : (
			<>
				<p class="em-breve" data-em-breve>
					{t.emBreve}
				</p>
				<div class="botoes">
					<a class="botao" href={REPOSITORIO}>
						{t.github}
					</a>
					<span class="botao desativado" aria-disabled="true" data-windows>
						{t.windows}
					</span>
				</div>
			</>
		)
	}
</section>

<style>
	.download {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		margin-block: 2rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1rem;
		background:
			radial-gradient(ellipse 70% 80% at 50% 0%, var(--adsmart-brilho), transparent 70%),
			var(--sl-color-bg-nav);
		text-align: center;
	}
	.download > p {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.botao {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-family: var(--adsmart-fonte-titulo);
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.15s ease;
	}
	.botoes {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}
	.desativado {
		border: 1px solid var(--sl-color-hairline-light);
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: not-allowed;
	}
	.botao:not(.desativado):hover {
		transform: translateY(-1px);
	}
	.em-breve {
		font-size: var(--sl-text-lg);
	}
	.download :global(.expressive-code),
	details {
		width: 100%;
		margin: 0;
		text-align: left;
	}
	summary {
		cursor: pointer;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
