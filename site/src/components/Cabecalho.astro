---
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import config from "virtual:starlight/user-config";
import { localeFromStarlight } from "../../scripts/locale.ts";
import { linkAtivo, linksCabecalho } from "../../scripts/navegacao.ts";
import { traducoes } from "../../scripts/traducoes.ts";

const shouldRenderSearch =
	config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";

const locale = localeFromStarlight(Astro.locals.starlightRoute.locale);
const pathname = Astro.url.pathname;
const nav = linksCabecalho(locale);
const t = traducoes(locale);
const temSidebar = Astro.locals.starlightRoute.hasSidebar;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="nav-principal print:hidden" aria-label={t.navAria}>
		{
			nav.map((link) => (
				<a
					href={link.href}
					class:list={{ ativo: linkAtivo(link.href, pathname, locale) }}
					aria-current={linkAtivo(link.href, pathname, locale) ? "page" : undefined}
				>
					{link.texto}
				</a>
			))
		}
	</nav>
	<div class="sl-flex print:hidden busca">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
	{
		(
			<details class:list={["menu-landing print:hidden", { "com-sidebar": temSidebar }]}>
				<summary aria-label={t.menuAria}>
					<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M4 7h16M4 12h16M4 17h16" />
					</svg>
				</summary>
				<div class="painel">
					<nav aria-label={t.navAria}>
						{
							nav.map((link) => (
								<a
									href={link.href}
									class:list={{ ativo: linkAtivo(link.href, pathname, locale) }}
									aria-current={linkAtivo(link.href, pathname, locale) ? "page" : undefined}
								>
									{link.texto}
								</a>
							))
						}
					</nav>
					<div class="painel-extras">
						<SocialIcons />
						<ThemeSelect />
						<LanguageSelect />
					</div>
				</div>
			</details>
		)
	}
</div>

<script>
	for (const menu of document.querySelectorAll<HTMLDetailsElement>("details.menu-landing")) {
		menu.addEventListener("click", (evento) => {
			if (evento.target instanceof Element && evento.target.closest("nav a")) {
				menu.open = false;
			}
		});
	}
</script>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: 1rem;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			flex-shrink: 0;
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.nav-principal {
			display: none;
			flex: 1 1 auto;
			min-width: 0;
			align-items: center;
			gap: 1.25rem;
			font-size: var(--sl-text-sm);
		}

		.nav-principal a,
		.painel nav a {
			color: var(--sl-color-gray-3);
			text-decoration: none;
			white-space: nowrap;
		}

		.nav-principal a:hover,
		.painel nav a:hover {
			color: var(--sl-color-white);
		}

		.nav-principal a.ativo,
		.painel nav a.ativo {
			color: var(--sl-color-white);
			font-weight: 600;
		}

		.busca {
			margin-inline-start: auto;
			flex-shrink: 0;
		}

		.right-group {
			display: none;
			flex-shrink: 0;
			gap: 1rem;
			align-items: center;
		}

		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		.social-icons::after {
			content: "";
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		.menu-landing {
			position: relative;
			flex-shrink: 0;
		}

		.menu-landing.com-sidebar {
			display: none;
		}

		.menu-landing summary {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2.5rem;
			height: 2.5rem;
			border-radius: 0.5rem;
			color: var(--sl-color-white);
			cursor: pointer;
			list-style: none;
		}

		.menu-landing summary::-webkit-details-marker {
			display: none;
		}

		.menu-landing[open] summary {
			background: var(--sl-color-gray-6);
		}

		.painel {
			position: absolute;
			inset-inline-end: 0;
			top: calc(100% + 0.75rem);
			width: min(18rem, calc(100vw - 2 * var(--sl-nav-pad-x)));
			padding: 1rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.75rem;
			background: var(--sl-color-bg-nav);
			box-shadow: var(--sl-shadow-lg);
		}

		.painel nav {
			display: flex;
			flex-direction: column;
		}

		.painel nav a {
			padding: 0.6rem 0.25rem;
			font-size: var(--sl-text-base);
		}

		.painel-extras {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			align-items: center;
			margin-top: 0.75rem;
			padding-top: 0.75rem;
			border-top: 1px solid var(--sl-color-gray-6);
		}

		@media (min-width: 50rem) {
			.right-group {
				display: flex;
			}
		}

		@media (min-width: 64rem) {
			.nav-principal {
				display: flex;
			}

			.busca {
				margin-inline-start: 0;
			}

			.menu-landing {
				display: none;
			}
		}

		@media (min-width: 50rem) and (max-width: 63.99rem) {
			.menu-landing.com-sidebar {
				display: block;
			}

			.painel-extras {
				display: none;
			}
		}
	}
</style>
